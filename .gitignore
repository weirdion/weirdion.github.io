# Hugo build output and caches (regenerated on every build)
/public/
/resources/
.hugo_build.lock

# Local secrets, if ever needed. Never commit these: this repo is public.
.env

# macOS
.DS_Store
._*
*.icloud

# Editors: machine-local state
.idea/
.vscode/*
# .vscode/settings.json is machine-local; keep it ignored (do not un-ignore)
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/

# Playwright MCP session artifacts (snapshots, screenshots, console logs)
.playwright-mcp/
